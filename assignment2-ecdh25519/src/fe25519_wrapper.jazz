// Export main arithmetic functions for testing

require "fe25519.jazz"

export
fn fe25519_cmov_wrapper(reg ptr u32[N] pr px, reg u32 b) -> reg ptr u32[N] {
    pr = pr;
    px = px;
    pr = fe25519_cmov(pr, px, b);
    pr = pr;
    return pr;
}

export
fn fe25519_freeze_wrapper(reg ptr u32[N] pr) -> reg ptr u32[N] {
    pr = pr;
    pr = fe25519_freeze(pr);
    pr = pr;
    return pr;
}

export
fn fe25519_iseq_wrapper(reg ptr u32[N] px py) -> reg u32 {
    px = px;
    py = py;
    reg u32 r;
    r = fe25519_iseq(px, py);
    r = r;
    return r;
}

export
fn fe25519_isnegative_wrapper(reg ptr u32[N] px) -> reg u32 {
    px = px;
    reg u32 r;
    r = fe25519_isnegative(px);
    r = r;
    return r;
}

