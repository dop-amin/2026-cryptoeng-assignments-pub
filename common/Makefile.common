##############################################################################
# Common Makefile for Cryptographic Engineering Assignments
#
# This file is included by assignment-specific Makefiles.
# It provides rules for building Jasmin code, C code, and firmware.
##############################################################################

# Toolchain
PREFIX ?= arm-none-eabi-
CC      = $(PREFIX)gcc
AS      = $(PREFIX)as
LD      = $(PREFIX)ld
OBJCOPY = $(PREFIX)objcopy
OBJDUMP = $(PREFIX)objdump
SIZE    = $(PREFIX)size
GDB     = $(PREFIX)gdb

# Jasmin compiler
JASMINC ?= jasminc

# OpenOCD
OPENOCD ?= openocd
OPENOCD_CFG ?= board/st_nucleo_l4.cfg

# QEMU
QEMU ?= qemu-system-arm
QEMU_MACHINE ?= mps2-an386
QEMU_FLAGS = -M $(QEMU_MACHINE) -nographic -semihosting

# Platform selection (default: board)
PLATFORM ?= board

# Target device configuration
ifeq ($(PLATFORM),qemu)
  DEVICE = CMSDK_CM4
  ARCH = cortex-m4
  FPU = fpv4-sp-d16
  LDSCRIPT ?= $(COMMON_DIR)/mps2.ld
  HAL_SRC = $(COMMON_DIR)/hal/hal-qemu.c
  STARTUP_SRC = $(COMMON_DIR)/mps2/startup_MPS2.S
else
  DEVICE = STM32L4R5ZI
  ARCH = cortex-m4
  FPU = fpv4-sp-d16
  LDSCRIPT ?= $(COMMON_DIR)/stm32l4r5zi.ld
  HAL_SRC = $(COMMON_DIR)/hal/hal.c
  STARTUP_SRC =
endif

# Paths
COMMON_DIR = $(REPO_ROOT)/common
LIBOPENCM3_DIR = $(COMMON_DIR)/libopencm3
HAL_DIR = $(COMMON_DIR)/hal
MPS2_DIR = $(COMMON_DIR)/mps2

# libopencm3 configuration (only for board platform)
OPENCM3_DIR = $(LIBOPENCM3_DIR)
LIBOPENCM3 = $(LIBOPENCM3_DIR)/lib/libopencm3_stm32l4.a

# Compiler flags
ARCH_FLAGS = -mthumb -mcpu=$(ARCH) -mfloat-abi=hard -mfpu=$(FPU)
CFLAGS += $(ARCH_FLAGS)
CFLAGS += -I$(HAL_DIR)
CFLAGS += -I$(SRC_DIR)
CFLAGS += -Wall -Wextra -Wimplicit-function-declaration
CFLAGS += -Wredundant-decls -Wmissing-prototypes -Wstrict-prototypes
CFLAGS += -fno-common -ffunction-sections -fdata-sections
CFLAGS += -MD -MP
CFLAGS += -g3 -O2

# Platform-specific compiler flags
ifeq ($(PLATFORM),qemu)
  CFLAGS += -I$(MPS2_DIR)
  CFLAGS += -DQEMU_PLATFORM
  CFLAGS += -DDATA_IN_FLASH
  ASFLAGS += -DDATA_IN_FLASH
else
  CFLAGS += -DSTM32L4
  CFLAGS += -I$(LIBOPENCM3_DIR)/include
endif

# Linker flags
LDFLAGS += $(ARCH_FLAGS)
LDFLAGS += -L$(SRC_DIR)
LDFLAGS += -T$(LDSCRIPT)
LDFLAGS += -nostartfiles
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -Wl,-Map=$(BUILD_DIR)/$(TARGET).map
LDFLAGS += --specs=nano.specs

# Platform-specific linker flags and libraries
ifeq ($(PLATFORM),qemu)
  LDLIBS += -lc -lnosys -lm
else
  LDFLAGS += -L$(LIBOPENCM3_DIR)/lib
  LDLIBS += -lopencm3_stm32l4
  LDLIBS += -lc -lnosys -lm
endif

# Jasmin flags
JASMINFLAGS += -arch arm-m4
JASMINFLAGS += -system linux

# Object files (platform-specific)
ifeq ($(PLATFORM),qemu)
  OBJS += $(HAL_SRC:.c=.o)
  OBJS += $(STARTUP_SRC:.S=.o)
else
  OBJS += $(HAL_SRC:.c=.o)
endif

# Build rules
.PHONY: all clean flash monitor debug size libopencm3 qemu-gdb

all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).bin $(BUILD_DIR)/$(TARGET).hex
	@$(SIZE) $(BUILD_DIR)/$(TARGET).elf

ifeq ($(PLATFORM),qemu)
$(BUILD_DIR)/$(TARGET).elf: $(OBJS) $(LDSCRIPT)
	@mkdir -p $(BUILD_DIR)
	@echo "  LD      $@"
	@$(CC) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $@
else
$(BUILD_DIR)/$(TARGET).elf: $(OBJS) $(LIBOPENCM3)
	@mkdir -p $(BUILD_DIR)
	@echo "  LD      $@"
	@$(CC) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $@
endif

$(BUILD_DIR)/$(TARGET).bin: $(BUILD_DIR)/$(TARGET).elf
	@echo "  OBJCOPY $@"
	@$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/$(TARGET).hex: $(BUILD_DIR)/$(TARGET).elf
	@echo "  OBJCOPY $@"
	@$(OBJCOPY) -O ihex $< $@

%.o: %.c
	@echo "  CC      $<"
	@$(CC) $(CFLAGS) -c $< -o $@

%.o: %.s
	@echo "  AS      $<"
	@$(AS) $(ARCH_FLAGS) $< -o $@

%.o: %.S
	@echo "  AS      $<"
	@$(CC) $(ARCH_FLAGS) $(CFLAGS) -c $< -o $@

# Jasmin compilation
%.s: %.jazz
	@echo "  JASMINC $<"
	@$(JASMINC) $(JASMINFLAGS) -o $@ $<

# libopencm3
$(LIBOPENCM3):
	@echo "Building libopencm3..."
	@if [ ! -d "$(LIBOPENCM3_DIR)" ]; then \
		echo "Error: libopencm3 not found at $(LIBOPENCM3_DIR)"; \
		echo "Please run: git submodule update --init --recursive"; \
		exit 1; \
	fi
	$(MAKE) -C $(LIBOPENCM3_DIR) TARGETS=stm32/l4

libopencm3: $(LIBOPENCM3)

# Flashing
flash: $(BUILD_DIR)/$(TARGET).bin
	@echo "Flashing $(BUILD_DIR)/$(TARGET).bin..."
	$(OPENOCD) -f $(OPENOCD_CFG) \
		-c "init" \
		-c "reset init" \
		-c "flash write_image erase $(BUILD_DIR)/$(TARGET).bin 0x08000000" \
		-c "reset run" \
		-c "shutdown"

# Serial monitor
monitor:
	@echo "Opening serial monitor (press Ctrl+C to exit)..."
	@python3 -m serial.tools.miniterm /dev/ttyACM0 115200 --eol LF

# Debugging
debug: $(BUILD_DIR)/$(TARGET).elf
	@echo "Starting OpenOCD server..."
	@$(OPENOCD) -f $(OPENOCD_CFG) &
	@sleep 2
	@echo "Starting GDB..."
	@$(GDB) -ex "target extended-remote localhost:3333" \
		-ex "monitor reset halt" \
		-ex "load" \
		-ex "monitor reset init" \
		$(BUILD_DIR)/$(TARGET).elf

# MPS2 linker script preprocessing (for QEMU platform)
$(COMMON_DIR)/mps2.ld: $(MPS2_DIR)/MPS2.ld
	@echo "  CPP     $@"
	@$(CC) -x c -E -P -DDATA_IN_FLASH $< -o $@

# QEMU emulation - GDB debugging only
qemu-gdb: $(BUILD_DIR)/$(TARGET).elf
	@echo "Starting QEMU with GDB server on port 1234..."
	@$(QEMU) $(QEMU_FLAGS) -kernel $< -s -S &
	@sleep 1
	@$(GDB) -ex "target remote localhost:1234" \
		-ex "load" \
		$<

# Show size
size: $(BUILD_DIR)/$(TARGET).elf
	@$(SIZE) $<
	@$(SIZE) -A $<

# Disassembly
disasm: $(BUILD_DIR)/$(TARGET).elf
	@$(OBJDUMP) -D $< > $(BUILD_DIR)/$(TARGET).dis
	@echo "Disassembly written to $(BUILD_DIR)/$(TARGET).dis"

# Clean
clean:
	@echo "Cleaning..."
	@rm -rf $(BUILD_DIR)
	@rm -f $(OBJS)
	@rm -f $(OBJS:.o=.d)
	@rm -f $(HAL_SRC:.c=.o) $(HAL_SRC:.c=.d)
	@rm -f $(STARTUP_SRC:.S=.o)
	@rm -f $(COMMON_DIR)/mps2.ld
	@find $(SRC_DIR) -name "*.s" -type f -delete
	@find $(SRC_DIR) -name "*.o" -type f -delete
	@find $(HAL_DIR) -name "*.o" -type f -delete
	@find $(HAL_DIR) -name "*.d" -type f -delete
	@find $(MPS2_DIR) -name "*.o" -type f -delete

clean-all: clean
	@if [ "$(PLATFORM)" != "qemu" ]; then \
		$(MAKE) -C $(LIBOPENCM3_DIR) clean; \
	fi

# Include dependency files
-include $(OBJS:.o=.d)

# Help
help:
	@echo "Available targets:"
	@echo "  all          - Build firmware (default)"
	@echo "  clean        - Clean build artifacts"
	@echo "  clean-all    - Clean everything including libopencm3"
	@echo ""
	@echo "Physical board targets:"
	@echo "  flash        - Flash firmware to board"
	@echo "  monitor      - Open serial monitor"
	@echo "  debug        - Start debugging session"
	@echo ""
	@echo "QEMU emulation targets:"
	@echo "  qemu-gdb     - Run in QEMU with GDB debugging"
	@echo ""
	@echo "Other targets:"
	@echo "  size         - Show firmware size"
	@echo "  disasm       - Generate disassembly"
	@echo "  libopencm3   - Build libopencm3 (board only)"
	@echo "  help         - Show this help"
	@echo ""
	@echo "Platform selection:"
	@echo "  PLATFORM=board   - Build for physical STM32 board (default)"
	@echo "  PLATFORM=qemu    - Build for QEMU mps2-an386 emulation"
	@echo ""
	@echo "Examples:"
	@echo "  make PLATFORM=qemu           # Build for QEMU"
	@echo "  make PLATFORM=qemu qemu-gdb  # Build and debug in QEMU"
